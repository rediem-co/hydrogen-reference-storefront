# Copy to .env and fill in. Nothing here is secret: every value is public in the browser.
#
# Shopify (from your Hydrogen storefront settings)
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
SESSION_SECRET=

# ── rediem ───────────────────────────────────────────────────────────────────
#
# Set REDIEM_API_URL to the environment rediem gave you. Everything else below is
# optional and follows from it, including which loader build is used, so the loader
# can never talk to a different environment than the rest of this storefront.
# With no REDIEM_API_URL and no REDIEM_LOADER_URL, no loader is fetched at all and
# the server log says so: a missing environment is reported rather than guessed.
#
# Do NOT copy the loader into this repository. A vendored loader is frozen at the
# version you copied, so fixes rediem publishes stop reaching your shoppers. The
# Content-Security-Policy in app/entry.server.tsx derives its allowed origins from
# these same values, so changing one here is enough; there is no second place to edit.

# Where the loader is fetched from. Optional: when unset, the build matching the environment
# REDIEM_API_URL names is used, so the loader never talks to a different environment than the
# rest of this storefront. Set it only to pin a specific loader, such as a pre-release channel.
# Sandbox: https://cdn.rediemsandbox.dev/headless/v1/rediem.js
# REDIEM_LOADER_URL=

# The widget iframe origin, the rediem API, and the asset host.
# Sandbox equivalents replace rediem.io with rediemsandbox.dev.
# REDIEM_WIDGET_URL=
# REDIEM_API_URL=
# REDIEM_ASSET_URL=

# The session exchange your server calls with your store credential.
# REDIEM_EXCHANGE_URL=

# Your store's per-merchant credential, issued by rediem. This one IS secret:
# it authenticates your server to the session exchange. Never expose it to the
# browser and never commit it.
# REDIEM_CREDENTIAL=
